# Telegram Bot 設定
# 1. 透過 Telegram 搜尋 @BotFather 建立機器人取得 Token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 2. 透過 Telegram 搜尋 @userinfobot 或將機器人加入群組後取得 Chat ID
TELEGRAM_CHAT_ID=your_chat_id_here

# 3. Google Gemini API Key（選填，用於為文章產生高品質 AI 智能重點摘要）
# 若未填寫將自動採用文章內文智慧摘要
GEMINI_API_KEY=

# 定時排程檢查時間（24小時制，以逗號分隔，例如一天 3 次：09:00,13:00,18:00）
SCHEDULE_TIMES=09:00,13:00,18:00

# 時區設定（預設為 Asia/Taipei）
TIMEZONE=Asia/Taipei
